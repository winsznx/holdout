# Copy to .env.local (apps/web) or .env (repo root). Never commit real values.

# LLM (OpenAI-compatible). Used by packages/llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Optional Qwen path (https://hackathon.bitgetops.com/v1)
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=

# Bitget read-only key (Tim's own account, used for the P1 sync check only)
BITGET_READONLY_KEY=
BITGET_READONLY_SECRET=
BITGET_READONLY_PASSPHRASE=

# Supabase (opt-in rulebooks and cohort aggregates)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel
VERCEL_TOKEN=
